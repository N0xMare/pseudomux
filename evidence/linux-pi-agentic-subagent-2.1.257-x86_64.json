 "observations": {
  "pi_startup_stalls": {
   "what": "four `pi -p` invocations idled 45 s to 6 min with zero connect(); no lease, no turn, no facade contact",
   "root_cause": "harness artifact, not pi-subagents, the adapter, or pmux: pi's print mode awaits stdin EOF (readPipedStdin) whenever stdin is not a TTY, and the launching shell's fd 0 was an inherited harness socket whose write side stayed open, so pi sat in epoll_wait on fd 0 until the enclosing timeout killed it",
   "reproduced": "deterministically with no model turns: socketpair stdin held open -> zero connections; shutdown(SHUT_WR) -> proceeds immediately; </dev/null -> 0 stalls in 21 runs, inherited fd 0 -> 4 stalls in ~24",
   "ruled_out": [
    "file locks",
    "child processes",
    "DNS/UDP",
    "pi.dev version check",
    "jiti transpile cache",
    "pi-subagents supervisor poll",
    "pmux facade"
   ],
   "mitigation": "launch non-interactive pi as `pi -p ... </dev/null`; the three recorded scenarios ran that way"
  }
 }
