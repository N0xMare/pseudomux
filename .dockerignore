# The Linux evidence image receives only declared build inputs. This prevents
# unrelated workspace files from entering `COPY . /workspace` even when their
# names are not on a secret-file denylist.
**
!.dockerignore
!.gitignore
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!LICENSE-APACHE
!LICENSE-MIT
!README.md
!docs
!docs/**
!evidence
!evidence/**
!bin
!bin/**
!clients
!clients/**
!crates
!crates/**
!scripts
!scripts/**
!tools
!tools/**
!tests
!tests/**
!vendor
!vendor/**
!fuzz
!fuzz/**

# Defense in depth inside allowlisted source trees.
.git
**/.git
.context
**/.context
target
**/target
node_modules
**/node_modules
dist
**/dist
coverage
**/coverage
__pycache__
**/__pycache__
.pytest_cache
**/.pytest_cache
.ruff_cache
**/.ruff_cache
.mypy_cache
**/.mypy_cache
.coverage
**/.coverage
.DS_Store
**/.DS_Store
.pseudomux
**/.pseudomux
.direnv
**/.direnv
.venv
**/.venv
venv
**/venv
.idea
**/.idea
.vscode
**/.vscode
*.log
**/*.log
*.jsonl
**/*.jsonl
*.sock
**/*.sock
*.db
**/*.db
*.sqlite
**/*.sqlite
*.sqlite-*
**/*.sqlite-*

.claude
**/.claude
.env
.env.*
**/.env
**/.env.*
.npmrc
**/.npmrc
.netrc
**/.netrc
.cargo/credentials
.cargo/credentials.toml
**/.cargo/credentials
**/.cargo/credentials.toml
credentials
**/credentials
credentials.toml
**/credentials.toml
*.pem
**/*.pem
*.key
**/*.key
*.p12
**/*.p12
*.pfx
**/*.pfx
id_rsa*
**/id_rsa*
id_ed25519*
**/id_ed25519*

# Canonical parser fixtures are intentional source inputs, not runtime logs.
!crates/claude/tests/fixtures/*.jsonl
!tools/phase0/fixtures/*.jsonl
